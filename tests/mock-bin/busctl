#!/usr/bin/env bash

set -u

scenario=${MOCK_SCENARIO:-multi}
interface=
path=
previous=

for argument in "$@"; do
    case $argument in
        org.freedesktop.DBus.ObjectManager|org.bluez.GattDescriptor1|org.bluez.GattCharacteristic1)
            interface=$argument
            path=$previous
            ;;
    esac
    previous=$argument
done

if [[ $interface == org.freedesktop.DBus.ObjectManager ]]; then
    if [[ $scenario == bluez_error ]]; then
        exit 1
    fi

    if [[ $scenario == missing ]]; then
        printf '%s\n' '{"data":[{"/org/bluez/hci0/dev_MISSING":{"org.bluez.Device1":{"Alias":{"data":"Another Board"},"Name":{"data":"Another Board"},"Connected":{"data":false}}}}]}'
        exit
    fi

    if [[ $scenario == disconnected ]]; then
        printf '%s\n' '{"data":[{"/org/bluez/hci0/dev_TEST":{"org.bluez.Device1":{"Alias":{"data":"Test Board"},"Name":{"data":"Test Board"},"Connected":{"data":false}}},"/org/bluez/hci0/dev_TEST/service001/char001":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}}}]}'
        exit
    fi

    if [[ $scenario == central_only ]]; then
        printf '%s\n' '{"data":[{"/org/bluez/hci0/dev_TEST":{"org.bluez.Device1":{"Alias":{"data":"Test Board"},"Name":{"data":"Test Board"},"Connected":{"data":true}}},"/org/bluez/hci0/dev_TEST/service001/char001":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}}}]}'
        exit
    fi

    printf '%s\n' '{"data":[{"/org/bluez/hci0/dev_TEST":{"org.bluez.Device1":{"Alias":{"data":"Test Board"},"Name":{"data":"Test Board"},"Connected":{"data":true}}},"/org/bluez/hci0/dev_TEST/service001/char001":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}},"/org/bluez/hci0/dev_TEST/service002/char002":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}},"/org/bluez/hci0/dev_TEST/service002/char002/desc001":{"org.bluez.GattDescriptor1":{"UUID":{"data":"00002901-0000-1000-8000-00805f9b34fb"},"Characteristic":{"data":"/org/bluez/hci0/dev_TEST/service002/char002"}}},"/org/bluez/hci0/dev_TEST/service003/char003":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}},"/org/bluez/hci0/dev_TEST/service003/char003/desc001":{"org.bluez.GattDescriptor1":{"UUID":{"data":"00002901-0000-1000-8000-00805f9b34fb"},"Characteristic":{"data":"/org/bluez/hci0/dev_TEST/service003/char003"}}},"/org/bluez/hci0/dev_TEST/service004/char004":{"org.bluez.GattCharacteristic1":{"UUID":{"data":"00002a19-0000-1000-8000-00805f9b34fb"}}},"/org/bluez/hci0/dev_TEST/service004/char004/desc001":{"org.bluez.GattDescriptor1":{"UUID":{"data":"00002901-0000-1000-8000-00805f9b34fb"},"Characteristic":{"data":"/org/bluez/hci0/dev_TEST/service004/char004"}}}}]}'
    exit
fi

if [[ $interface == org.bluez.GattDescriptor1 ]]; then
    case $path in
        */service002/*)
            printf '%s\n' '{"data":[[80,101,114,105,112,104,101,114,97,108,32,48,0]]}'
            ;;
        */service003/*)
            printf '%s\n' '{"data":[[80,101,114,105,112,104,101,114,97,108,32,50]]}'
            ;;
        */service004/*)
            printf '%s\n' '{"data":[[80,101,114,105,112,104,101,114,97,108,32,49]]}'
            ;;
        *)
            exit 1
            ;;
    esac
    exit
fi

if [[ $interface == org.bluez.GattCharacteristic1 ]]; then
    case $path in
        */service001/*)
            printf '%s\n' '{"data":[[79]]}'
            ;;
        */service002/*)
            printf '%s\n' '{"data":[[77]]}'
            ;;
        */service003/*)
            exit 1
            ;;
        */service004/*)
            printf '%s\n' '{"data":[[88]]}'
            ;;
        *)
            exit 1
            ;;
    esac
    exit
fi

exit 1
