{
  "id": "zmkBattery",
  "name": "ZmkBattery",
  "description": "Shows connected ZMK keyboards and supported USB device batteries",
  "version": "1.4.0",
  "author": "ayak",
  "license": "MIT",
  "icon": "keyboard",
  "type": "widget",
  "capabilities": [
    "dankbar-widget",
    "process"
  ],
  "component": "./ZmkBatteryWidget.qml",
